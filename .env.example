# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
CVX_DOMAIN=cvx.example.com
CVX_BASE_URL=https://cvx.example.com

# openssl rand -hex 32
CVX_SESSION_SECRET=

# Without this, anyone with a Google or GitHub account can sign in.
CVX_ALLOWED_EMAILS=you@example.com

CVX_LLM_PROVIDER=groq
GROQ_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RESEND_API_KEY=
CVX_EMAIL_FROM=
